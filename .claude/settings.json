{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm lint)",
      "Bash(pnpm check-types)",
      "Bash(pnpm build)",
      "Bash(pnpm test *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)"
    ]
  }
}
